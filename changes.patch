index 0000000000..2f46bd0798
--- /dev/null
+++ b/submodules/TelegramUI/Components/Chat/ChatMessageEnvelopeBubbleContentNode/Sources/EnvelopeOpeningBurstView.swift
@@ -0,0 +1,59 @@
+import UIKit
+
+/// A short, non-interactive spray above the chat, starting at the envelope mouth.
+final class EnvelopeOpeningBurstView: UIView {
+    static func play(in card: UIView, artwork: CGRect, glyphs: [String]) -> EnvelopeOpeningBurstView? {
+        guard !UIAccessibility.isReduceMotionEnabled, let window = card.window, !glyphs.isEmpty, artwork.width > 0 else { return nil }
+        let burst = EnvelopeOpeningBurstView(frame: window.bounds)
+        burst.isUserInteractionEnabled = false
+        burst.accessibilityElementsHidden = true
+        burst.clipsToBounds = true
+        window.addSubview(burst)
+
+        let start = card.convert(CGPoint(x: artwork.midX, y: artwork.minY + 5), to: burst)
+        CATransaction.begin()
+        CATransaction.setCompletionBlock { [weak burst] in burst?.removeFromSuperview() }
+        let count = glyphs.count * 2 + 1
+        for index in 0 ..< count {
+            let glyph = glyphs[index % glyphs.count]
+            let direction: CGFloat = [-0.98, 0.86, -0.24, 0.50, -0.65, 0.99, 0.12][index]
+            let diameter = CGFloat(18 + index % 3 * 3)
+            let particle = UILabel(frame: CGRect(x: 0, y: 0, width: diameter + 4, height: diameter + 4))
+            particle.textAlignment = .center
+            particle.font = UIFont.systemFont(ofSize: diameter)
+            particle.text = glyph
+            particle.center = start
+            particle.layer.opacity = 0
+            burst.addSubview(particle)
+
+            let endX = min(burst.bounds.maxX - 20, max(20, start.x + direction * min(190, burst.bounds.width * 0.46)))
+            let dx = endX - start.x
+            let upward = start.y > 160
+            let end = CGPoint(x: endX, y: start.y + (upward ? -35 - CGFloat(index % 3) * 24 : 96 + CGFloat(index % 3) * 12))
+            let curve = UIBezierPath()
+            curve.move(to: start)
+            curve.addQuadCurve(to: end, controlPoint: CGPoint(x: start.x + dx * 0.55, y: start.y + (upward ? -185 : 24) + 25 * abs(direction)))
+            let position = CAKeyframeAnimation(keyPath: "position")
+            position.path = curve.cgPath
+            position.calculationMode = .linear
+            let scale = CAKeyframeAnimation(keyPath: "transform.scale")
+            scale.values = [0.3, 1.0, 0.7]
+            scale.keyTimes = [0, 0.25, 1]
+            let rotation = CABasicAnimation(keyPath: "transform.rotation.z")
+            rotation.fromValue = -direction * 0.2
+            rotation.toValue = direction * 0.7
+            let opacity = CAKeyframeAnimation(keyPath: "opacity")
+            opacity.values = [0, 1, 1, 0]
+            opacity.keyTimes = [0, 0.12, 0.64, 1]
+            let group = CAAnimationGroup()
+            group.duration = 1.05 + Double(index % 3) * 0.07
+            let animations: [CAAnimation] = [position, scale, rotation, opacity]
+            for animation in animations { animation.duration = group.duration }
+            group.animations = animations
+            group.beginTime = particle.layer.convertTime(CACurrentMediaTime(), from: nil) + 0.12 + Double(index / glyphs.count) * 0.31 + Double(index % glyphs.count) * 0.095
+            particle.layer.add(group, forKey: "envelope.openingBurst")
+        }
+        CATransaction.commit()
+        return burst
+    }
+}
diff --git a/tools/configure_envelope_simulator.py b/tools/configure_envelope_simulator.py
new file mode 100644
index 0000000000..f8320f24a3
--- /dev/null
+++ b/tools/configure_envelope_simulator.py
@@ -0,0 +1,78 @@
+#!/usr/bin/env python3
+"""Provision the current Simulator chat in the local demo ledger. No real funds."""
+import argparse
+import json
+import os
+from pathlib import Path
+import subprocess
+
+from envelope_demo_server import Ledger, SCALE, USDT_SCALE
+
+
+def private_json(path, value):
+    temporary = path.with_name(path.name + ".tmp")
+    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    try:
+        with os.fdopen(descriptor, "w") as stream:
+            json.dump(value, stream, indent=2)
+        temporary.replace(path)
+    finally:
+        temporary.unlink(missing_ok=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--simulator", required=True)
+    parser.add_argument("--bundle", required=True)
+    parser.add_argument("--database", type=Path, required=True)
+    parser.add_argument("--config", type=Path, required=True, help="Private operator token file outside Git")
+    parser.add_argument("--port", type=int, default=8787)
+    args = parser.parse_args()
+    if not 1024 <= args.port <= 65535:
+        parser.error("port must be between 1024 and 65535")
+    container = Path(subprocess.check_output(["xcrun", "simctl", "get_app_container", args.simulator, args.bundle, "data"], text=True).strip())
+    documents = container / "Documents"
+    setup_file = documents / "telegram-envelopes-setup.json"
+    if not setup_file.is_file():
+        parser.error("open the new Envelope form in a private chat first, then run this tool again")
+    setup = json.loads(setup_file.read_text())
+    sender, recipient = setup["accountId"], setup["recipientId"]
+    if any(type(value) is not int or not 0 < value < 2**56 for value in (sender, recipient)) or sender == recipient:
+        parser.error("open a normal private chat's Envelope form first")
+    url = f"http://localhost:{args.port}"
+    configuration = {"serverURL": url, "accounts": {}}
+    if args.config.exists():
+        configuration = json.loads(args.config.read_text())
+        if configuration.get("serverURL") != url or not isinstance(configuration.get("accounts"), dict):
+            parser.error("operator configuration belongs to another service")
+    ledger = Ledger(args.database)
+    # Provisioning is performed by this local operator tool, never by HTTP clients.
+    # Existing tokens and balances are preserved, and every existing token is checked.
+    for account, balance, balance_usdt in [(sender, 1000 * SCALE, 1000 * USDT_SCALE), (recipient, 0, 0)]:
+        token = configuration["accounts"].get(str(account))
+        if token:
+            with ledger.connection() as db:
+                row = db.execute("SELECT token_hash FROM accounts WHERE id=?", (account,)).fetchone()
+                if row is None or row["token_hash"] != ledger.digest(token):
+                    parser.error("saved token does not match ledger; refusing to reset the account")
+        else:
+            token = ledger.provision(account, balance, balance_usdt)
+            configuration["accounts"][str(account)] = token
+            private_json(args.config, configuration)
+    # Only the currently logged-in sender's token is installed into this client.
+    # The second identity's token stays with the operator until recipient testing.
+    destination = documents / "telegram-envelopes-demo.json"
+    installed_accounts = {}
+    if destination.exists():
+        installed = json.loads(destination.read_text())
+        if installed.get("serverURL") != url:
+            parser.error("client configuration belongs to another service; refusing to overwrite it")
+        installed_accounts = {account: token for account, token in installed.get("accounts", {}).items()
+                              if configuration["accounts"].get(account) == token}
+    installed_accounts[str(sender)] = configuration["accounts"][str(sender)]
+    private_json(destination, {"serverURL": url, "accounts": installed_accounts})
+    print("Simulator demo wallet connected. Reopen the Envelope form. Tokens were not printed; existing balances were preserved.")
+
+
+if __name__ == "__main__":
+    main()
