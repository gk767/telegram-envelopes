+    private func hinge(_ angle: CGFloat) -> CATransform3D {
+        var t = CATransform3DIdentity
+        t.m34 = -1 / max(350, self.bounds.width * 2.8)
+        return CATransform3DRotate(t, angle, 1, 0, 0)
