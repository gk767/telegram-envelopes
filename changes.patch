diff --git a/submodules/TelegramUI/Components/Chat/ChatMessageEnvelopeBubbleContentNode/Sources/ChatMessageEnvelopeBubbleContentNode.swift b/submodules/TelegramUI/Components/Chat/ChatMessageEnvelopeBubbleContentNode/Sources/ChatMessageEnvelopeBubbleContentNode.swift
